{
  "name": "vanillajs-excelike-table",
  "version": "2.4.0",
  "description": "Excel-like data table in plain JavaScript: sorting, Excel-style filters, pagination, column pinning, conditional formatting and CSV export with zero configuration.",
  "type": "module",
  "main": "./dist/excelike-table.cjs",
  "module": "./dist/excelike-table.js",
  "types": "./dist/excelike-table.d.ts",
  "unpkg": "./dist/excelike-table.browser.js",
  "jsdelivr": "./dist/excelike-table.browser.js",
  "files": [
    "dist",
    "README.md",
    "README.ja.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/excelike-table.d.ts",
      "import": "./dist/excelike-table.js",
      "require": "./dist/excelike-table.cjs"
    },
    "./styles": "./dist/excelike-table.css",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "keywords": [
    "javascript",
    "vanillajs",
    "table",
    "excel",
    "filter",
    "sort",
    "pagination",
    "column-helpers",
    "preset",
    "ui",
    "vanilla",
    "no-framework",
    "user-friendly",
    "settings-persistence",
    "column-pinning",
    "responsive",
    "pure-javascript"
  ],
  "author": "ExceLikeTable Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pfkbn172/vanillajs-excelike-table.git"
  },
  "bugs": {
    "url": "https://github.com/pfkbn172/vanillajs-excelike-table/issues"
  },
  "homepage": "https://github.com/pfkbn172/vanillajs-excelike-table#readme",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev-server.mjs",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest tests/unit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "prepublishOnly": "npm run lint && npm run build && npm test && npm run test:node && npm run test:types && npm run test:e2e",
    "lint": "eslint .",
    "test:node": "node --test tests/node/*.test.mjs",
    "test:types": "tsc --noEmit"
  },
  "devDependencies": {
    "@babel/core": "^7.22.0",
    "@babel/plugin-proposal-class-properties": "^7.18.0",
    "@babel/plugin-proposal-object-rest-spread": "^7.20.0",
    "@babel/preset-env": "^7.22.0",
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.62.0",
    "babel-jest": "^29.5.0",
    "esbuild": "0.25.10",
    "eslint": "9.39.1",
    "globals": "16.5.0",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.5.0",
    "terser": "^5.0.0",
    "typescript": "5.9.3",
    "whatwg-fetch": "^3.6.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "engines": {
    "node": ">=14.0.0"
  }
}
